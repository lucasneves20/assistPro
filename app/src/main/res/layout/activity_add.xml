<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dracula_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/titulo_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adicionar"
            android:textColor="@color/dracula_purple"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:contentDescription="Imagem do boleto"
            android:padding="6dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_foto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/tirar_foto"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_galeria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/galeria"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_arquivos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/arquivos"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Fotografe, escolha na galeria ou navegue nos arquivos (imagem ou PDF) para preencher automaticamente."
            android:textColor="@color/dracula_comment"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/campo_descricao"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/descricao"
            android:inputType="textCapSentences"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/campo_linha"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/linha_digitavel"
            android:inputType="number"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/campo_valor"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/valor"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/campo_vencimento"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="@string/vencimento"
            android:importantForAutofill="no"
            android:inputType="none" />

        <Button
            android:id="@+id/btn_salvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/salvar" />

    </LinearLayout>
</ScrollView>
