<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/campo_observacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/checkpoint_observacao"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="4"
        android:maxLines="8"
        android:padding="12dp"
        android:textColor="@color/dracula_fg"
        android:textColorHint="@color/dracula_comment"
        android:textSize="14sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_bug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/checkpoint_eh_bug"
        android:textColor="@color/dracula_fg"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/checkpoint_feedback_desc"
        android:textColor="@color/dracula_comment"
        android:textSize="12sp" />

</LinearLayout>
